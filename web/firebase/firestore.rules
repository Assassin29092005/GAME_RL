rules_version = '2';

// HellwalkerRL research telemetry: who may read and write what (web/CONTRACT.md v1 is the spec; this file is its
// "Rules" section). web/dev/mock_firebase.py enforces the same checks, so web/dev/e2e_test.py exercises them.
//
//   players/{uid}   public read; create / update by that uid only, schema-checked; never deleted
//   fights/{id}     public read; created once by its player, schema-checked; never updated; deleted by its player (reset)
//   surveys/{uid}   private: read / write by that uid only (the free-text comment)
//   anything else   denied (no rule matches)
//
// Every upload is anonymous: request.auth.uid is the install's anonymous Firebase user. Counts are bounded so a bad
// client cannot write absurd numbers; server times (createdAt, lastSeen, at, resetAt) must be REQUEST_TIME transforms.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ------------------------------------------------------------------------------------------------

    function isUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // A count: an integer in [0, hi].
    function count(v, hi) {
      return v is int && v >= 0 && v <= hi;
    }

    // An amount (seconds, damage): a number in [0, hi].
    function amount(v, hi) {
      return v is number && v >= 0 && v <= hi;
    }

    function frac(v) {
      return v is number && v >= 0 && v <= 1;
    }

    function text(v, lo, hi) {
      return v is string && v.size() >= lo && v.size() <= hi;
    }

    // 1..24 printable characters, not only spaces.
    function nickname(v) {
      return v is string && v.size() >= 1 && v.size() <= 24 && v.trim().size() >= 1
        && v.matches('^[^\\x00-\\x1F\\x7F]+$');
    }

    function difficulty(v) {
      return v in ['Easy', 'Normal', 'Hard', 'Hellwalker', 'Adaptive'];
    }

    // What the player did against one class of keeper swing: {parry|block|stepL|stepR|stepB|stepF|attack|none: count}.
    function answerCounts(m, hi) {
      return m is map
        && m.keys().hasOnly(['parry', 'block', 'stepL', 'stepR', 'stepB', 'stepF', 'attack', 'none'])
        && count(m.get('parry', 0), hi) && count(m.get('block', 0), hi)
        && count(m.get('stepL', 0), hi) && count(m.get('stepR', 0), hi)
        && count(m.get('stepB', 0), hi) && count(m.get('stepF', 0), hi)
        && count(m.get('attack', 0), hi) && count(m.get('none', 0), hi);
    }

    // {fast|heavy|feint|killer: answerCounts}
    function answers(a, hi) {
      return a is map
        && a.keys().hasOnly(['fast', 'heavy', 'feint', 'killer'])
        && answerCounts(a.get('fast', {}), hi) && answerCounts(a.get('heavy', {}), hi)
        && answerCounts(a.get('feint', {}), hi) && answerCounts(a.get('killer', {}), hi);
    }

    // One row of the keeper's expectations: {attack: string, answer: string, p: 0..1}.
    function expectedRow(e) {
      return e is map && e.keys().hasOnly(['attack', 'answer', 'p']) && e.keys().hasAll(['attack', 'answer', 'p'])
        && text(e.attack, 1, 32) && text(e.answer, 1, 32) && frac(e.p);
    }

    // At most 8 rows (one per keeper attack; empty for the script). Rules cannot loop, so each index is checked.
    function expectedList(x) {
      return x is list && x.size() <= 8
        && (x.size() < 1 || expectedRow(x[0])) && (x.size() < 2 || expectedRow(x[1]))
        && (x.size() < 3 || expectedRow(x[2])) && (x.size() < 4 || expectedRow(x[3]))
        && (x.size() < 5 || expectedRow(x[4])) && (x.size() < 6 || expectedRow(x[5]))
        && (x.size() < 7 || expectedRow(x[6])) && (x.size() < 8 || expectedRow(x[7]));
    }

    // ---- players/{uid} ------------------------------------------------------------------------------------------

    // Lifetime totals. Every key optional (the server increments create them); bounded; consistent where it is
    // certain (wins within fights, correct reads within reads).
    function totals(t) {
      let n = 100000000;
      return t is map
        && t.keys().hasOnly(['fights', 'wins', 'losses', 'timeouts', 'seconds', 'dmgDealt', 'dmgTaken',
                             'playerSwings', 'playerHits', 'keeperSwings', 'keeperHits', 'keeperBlocked',
                             'keeperParried', 'keeperWhiffed', 'parryAttempts', 'dodges', 'readsLanded',
                             'predictions', 'predictionsCorrect', 'confident', 'confidentCorrect'])
        && count(t.get('fights', 0), n) && count(t.get('wins', 0), n) && count(t.get('losses', 0), n)
        && count(t.get('timeouts', 0), n)
        && amount(t.get('seconds', 0), 10000000000) && amount(t.get('dmgDealt', 0), 1000000000000)
        && amount(t.get('dmgTaken', 0), 1000000000000)
        && count(t.get('playerSwings', 0), n) && count(t.get('playerHits', 0), n)
        && count(t.get('keeperSwings', 0), n) && count(t.get('keeperHits', 0), n)
        && count(t.get('keeperBlocked', 0), n) && count(t.get('keeperParried', 0), n)
        && count(t.get('keeperWhiffed', 0), n) && count(t.get('parryAttempts', 0), n)
        && count(t.get('dodges', 0), n) && count(t.get('readsLanded', 0), n)
        && count(t.get('predictions', 0), n) && count(t.get('predictionsCorrect', 0), n)
        && count(t.get('confident', 0), n) && count(t.get('confidentCorrect', 0), n)
        && t.get('wins', 0) <= t.get('fights', 0)
        && t.get('predictionsCorrect', 0) <= t.get('predictions', 0)
        && t.get('confidentCorrect', 0) <= t.get('confident', 0);
    }

    // How much one write may add to a lifetime counter: one fight's worth (a reset is checked on its own).
    function grew(d, old, k, hi) {
      let delta = d.totals.get(k, 0) - old.get('totals', {}).get(k, 0);
      return delta >= 0 && delta <= hi;
    }

    function totalsGrowthOk(d, old) {
      let c = 1000000;
      return grew(d, old, 'wins', 1) && grew(d, old, 'losses', 1) && grew(d, old, 'timeouts', 1)
        && grew(d, old, 'seconds', 86400) && grew(d, old, 'dmgDealt', 10000000) && grew(d, old, 'dmgTaken', 10000000)
        && grew(d, old, 'playerSwings', c) && grew(d, old, 'playerHits', c)
        && grew(d, old, 'keeperSwings', c) && grew(d, old, 'keeperHits', c)
        && grew(d, old, 'keeperBlocked', c) && grew(d, old, 'keeperParried', c) && grew(d, old, 'keeperWhiffed', c)
        && grew(d, old, 'parryAttempts', c) && grew(d, old, 'dodges', c) && grew(d, old, 'readsLanded', c)
        && grew(d, old, 'predictions', c) && grew(d, old, 'predictionsCorrect', c)
        && grew(d, old, 'confident', c) && grew(d, old, 'confidentCorrect', c);
    }

    // A keeper's record grows by at most one fight (and one win) per write.
    function keeperGrew(d, old, k) {
      let now = d.keepers.get(k, {});
      let was = old.get('keepers', {}).get(k, {});
      let df = now.get('fights', 0) - was.get('fights', 0);
      let dw = now.get('wins', 0) - was.get('wins', 0);
      return df >= 0 && df <= 1 && dw >= 0 && dw <= 1;
    }

    function keepersGrowthOk(d, old) {
      return keeperGrew(d, old, 'warden') && keeperGrew(d, old, 'sage') && keeperGrew(d, old, 'returned');
    }

    function keeperRecord(k) {
      return k is map && k.keys().hasOnly(['fights', 'wins'])
        && count(k.get('fights', 0), 100000000) && count(k.get('wins', 0), 100000000)
        && k.get('wins', 0) <= k.get('fights', 0);
    }

    function keepers(k) {
      return k is map && k.keys().hasOnly(['warden', 'sage', 'returned'])
        && keeperRecord(k.get('warden', {})) && keeperRecord(k.get('sage', {})) && keeperRecord(k.get('returned', {}));
    }

    // The Likert part of the survey (public, anonymous). `at` is the server time of the answer.
    function likert(v) {
      return v is int && v >= 1 && v <= 5;
    }

    function survey(s) {
      return s is map
        && s.keys().hasOnly(['feltRead', 'fair', 'difficulty', 'fun', 'playAgain', 'noticedAdapting', 'at'])
        && s.keys().hasAll(['feltRead', 'fair', 'difficulty', 'fun', 'playAgain', 'noticedAdapting', 'at'])
        && likert(s.feltRead) && likert(s.fair) && likert(s.difficulty) && likert(s.fun) && likert(s.playAgain)
        && s.noticedAdapting is bool && s.at == request.time;
    }

    function playerKeys(d) {
      return d.keys().hasOnly(['v', 'nickname', 'createdAt', 'lastSeen', 'gameVersion', 'difficulty', 'totals',
                               'keepers', 'answers', 'expected', 'survey', 'resets', 'resetAt']);
    }

    // Created once by the game: nickname, server-time createdAt, everything at zero.
    function playerCreateOk(d) {
      return playerKeys(d) && d.keys().hasAll(['v', 'nickname', 'createdAt'])
        && d.v == 1 && nickname(d.nickname) && d.createdAt == request.time
        && (!('lastSeen' in d) || d.lastSeen == request.time)
        && (!('gameVersion' in d) || text(d.gameVersion, 0, 32))
        && (!('difficulty' in d) || difficulty(d.difficulty))
        && (!('totals' in d) || (totals(d.totals) && d.totals.values().hasOnly([0, 0.0])))
        && (!('keepers' in d) || keepers(d.keepers))
        && (!('answers' in d) || answers(d.answers, 0))
        && (!('expected' in d) || expectedList(d.expected))
        && !('survey' in d)
        && (!('resets' in d) || d.resets == 0)
        && (!('resetAt' in d) || d.resetAt == null);
    }

    // Updated by the game after every fight (one fight per commit: totals.fights grows by at most 1), by the site
    // (nickname, survey) and by the reset (totals, keepers and answers to zero, expected [], resets + 1, resetAt now).
    // Only the fields that changed are checked; createdAt never changes.
    function playerUpdateOk(d, old) {
      let changed = d.diff(old).affectedKeys();
      let isReset = changed.hasAny(['resets']);
      return playerKeys(d) && d.keys().hasAll(['v', 'nickname', 'createdAt'])
        && !changed.hasAny(['createdAt'])
        && (!changed.hasAny(['v']) || d.v == 1)
        && (!changed.hasAny(['nickname']) || nickname(d.nickname))
        && (!changed.hasAny(['lastSeen']) || d.lastSeen == request.time)
        && (!changed.hasAny(['gameVersion']) || text(d.gameVersion, 0, 32))
        && (!changed.hasAny(['difficulty']) || difficulty(d.difficulty))
        && (!changed.hasAny(['totals']) || (totals(d.totals)
              && (isReset || (d.totals.get('fights', 0) >= old.get('totals', {}).get('fights', 0)
                              && d.totals.get('fights', 0) <= old.get('totals', {}).get('fights', 0) + 1
                              && totalsGrowthOk(d, old)))))
        && (!changed.hasAny(['keepers']) || (keepers(d.keepers) && (isReset || keepersGrowthOk(d, old))))
        && (!changed.hasAny(['answers']) || answers(d.answers, 100000000))
        && (!changed.hasAny(['expected']) || expectedList(d.expected))
        && (!changed.hasAny(['survey']) || survey(d.survey))
        && (!isReset || (d.resets == old.get('resets', 0) + 1 && d.resetAt == request.time
                         && d.get('totals', {}).values().hasOnly([0, 0.0]) && d.get('expected', []).size() == 0))
        && (!changed.hasAny(['resetAt']) || (isReset && d.resetAt == request.time));
    }

    match /players/{uid} {
      allow read: if true;
      allow create: if isUser(uid) && playerCreateOk(request.resource.data);
      allow update: if isUser(uid) && playerUpdateOk(request.resource.data, resource.data);
      allow delete: if false;
    }

    // ---- fights/{fightId} ---------------------------------------------------------------------------------------

    function fightOk(f) {
      let c = 1000000;
      return f.keys().hasOnly(['v', 'player', 'at', 'clientTime', 'session', 'fightInSession', 'gameVersion', 'mode',
                               'playMode', 'brain', 'keeper', 'keeperName', 'difficulty', 'skill', 'adaptive', 'result',
                               'seconds', 'playerHealth', 'keeperHealth', 'dmgDealt', 'dmgTaken', 'playerSwings',
                               'playerHits', 'keeperSwings', 'keeperHits', 'keeperBlocked', 'keeperParried',
                               'keeperWhiffed', 'parryAttempts', 'dodges', 'guardBreaks', 'keeperExposed',
                               'readsLanded', 'predictions', 'predictionsCorrect', 'confident', 'confidentCorrect',
                               'expected', 'answers'])
        && f.keys().hasAll(['v', 'player', 'at', 'clientTime', 'session', 'fightInSession', 'gameVersion', 'mode',
                            'playMode', 'brain', 'keeper', 'keeperName', 'difficulty', 'skill', 'adaptive', 'result',
                            'seconds', 'playerHealth', 'keeperHealth', 'dmgDealt', 'dmgTaken', 'playerSwings',
                            'playerHits', 'keeperSwings', 'keeperHits', 'keeperBlocked', 'keeperParried',
                            'keeperWhiffed', 'parryAttempts', 'dodges', 'guardBreaks', 'keeperExposed',
                            'readsLanded', 'predictions', 'predictionsCorrect', 'confident', 'confidentCorrect',
                            'expected', 'answers'])
        && f.v == 1
        && f.at == request.time
        && f.clientTime is timestamp
        && f.session is string && f.session.matches('^[0-9a-f]{32}$')
        && f.fightInSession is int && f.fightInSession >= 1 && f.fightInSession <= c
        && text(f.gameVersion, 1, 32)
        && f.mode in ['openworld', 'arena']
        && f.playMode in ['pathbreaker', 'hellwalker', '66days', 'arena']
        && f.brain in ['rl', 'script']
        && f.keeper in [0, 1, 2]
        && text(f.keeperName, 0, 64)
        && difficulty(f.difficulty)
        && frac(f.skill)
        && f.adaptive is bool
        && f.result in ['win', 'loss', 'timeout', 'quit']
        && amount(f.seconds, 86400)
        && frac(f.playerHealth) && frac(f.keeperHealth)
        && amount(f.dmgDealt, 10000000) && amount(f.dmgTaken, 10000000)
        && count(f.playerSwings, c) && count(f.playerHits, c)
        && count(f.keeperSwings, c) && count(f.keeperHits, c)
        && count(f.keeperBlocked, c) && count(f.keeperParried, c) && count(f.keeperWhiffed, c)
        && count(f.parryAttempts, c) && count(f.dodges, c)
        && count(f.guardBreaks, c) && count(f.keeperExposed, c) && count(f.readsLanded, c)
        && count(f.predictions, c) && count(f.predictionsCorrect, c)
        && count(f.confident, c) && count(f.confidentCorrect, c)
        && f.predictionsCorrect <= f.predictions && f.confidentCorrect <= f.confident
        && expectedList(f.expected)
        && answers(f.answers, c);
    }

    match /fights/{fightId} {
      allow read: if true;
      allow create: if fightId.matches('^[0-9a-f]{32}$') && isUser(request.resource.data.player)
        && fightOk(request.resource.data);
      allow update: if false;
      allow delete: if isUser(resource.data.player);
    }

    // ---- surveys/{uid} (private) --------------------------------------------------------------------------------

    match /surveys/{uid} {
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['v', 'comment', 'at'])
        && request.resource.data.keys().hasAll(['v', 'comment', 'at'])
        && request.resource.data.v == 1
        && text(request.resource.data.comment, 0, 500)
        && request.resource.data.at == request.time;
    }
  }
}
