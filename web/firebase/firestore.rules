rules_version = '2';

// HellwalkerRL research telemetry: who may read and write what (web/CONTRACT.md v2 is the spec; this file is its
// "Rules" section). web/dev/mock_firebase.py enforces the same checks, so web/dev/e2e_test.py exercises them.
//
//   players/{uid}   public read; create / update by that uid only, schema-checked; never deleted
//   fights/{id}     public read; created once by its player, schema-checked; never updated; deleted by its player (reset)
//   surveys/{uid}   private: read / write by that uid only (the free-text comment)
//   anything else   denied (no rule matches)
//
// Every upload is anonymous: request.auth.uid is the install's anonymous Firebase user. Server times (createdAt, lastSeen,
// at, resetAt) must be REQUEST_TIME transforms.
//
// LEAN BY DESIGN: real Firestore evaluates at most 1,000 expressions per request, and a fight upload is one commit of two
// writes (the fight + the player's totals). The first rules checked every counter and nested map field by field — fine in
// the local mock, refused by real Firestore (2026-10-04: every player create and totals update was PERMISSION_DENIED).
// So the rules check SHAPE (exactly the allowed keys), OWNERSHIP, SERVER TIME, the research fields that identify a fight,
// and that lifetime fights / wins / losses / timeouts and each keeper's record grow by at most one fight per write. The
// per-fight documents are the research data; a client can only ever write its own. Keep every rule cheap.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ------------------------------------------------------------------------------------------------

    function isUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function text(v, lo, hi) {
      return v is string && v.size() >= lo && v.size() <= hi;
    }

    // 1..24 printable characters, not only spaces.
    function nickname(v) {
      return v is string && v.size() >= 1 && v.size() <= 24 && v.trim().size() >= 1
        && v.matches('^[^\\x00-\\x1F\\x7F]+$');
    }

    function difficulty(v) {
      return v in ['Easy', 'Normal', 'Hard', 'Hellwalker', 'Adaptive'];
    }

    // ---- players/{uid} ------------------------------------------------------------------------------------------

    // Lifetime totals: exactly the allowed keys (the server increments create them as fights arrive).
    function totalsShape(t) {
      return t is map
        && t.keys().hasOnly(['fights', 'wins', 'losses', 'timeouts', 'seconds', 'dmgDealt', 'dmgTaken',
                             'playerSwings', 'playerHits', 'keeperSwings', 'keeperHits', 'keeperBlocked',
                             'keeperParried', 'keeperWhiffed', 'parryAttempts', 'dodges', 'readsLanded',
                             'predictions', 'predictionsCorrect', 'confident', 'confidentCorrect']);
    }

    // A lifetime count grows by at most one fight's worth per write (never shrinks outside a reset).
    function grewBy(t, was, k, hi) {
      let delta = t.get(k, 0) - was.get(k, 0);
      return delta >= 0 && delta <= hi;
    }

    // fights / wins / losses / timeouts by one; the counts the leaderboards rank by (parries, reads) by one fight's worth.
    function totalsGrowthOk(d, old) {
      let was = old.get('totals', {});
      return grewBy(d.totals, was, 'fights', 1) && grewBy(d.totals, was, 'wins', 1)
        && grewBy(d.totals, was, 'losses', 1) && grewBy(d.totals, was, 'timeouts', 1)
        && grewBy(d.totals, was, 'keeperParried', 5000) && grewBy(d.totals, was, 'parryAttempts', 5000)
        && grewBy(d.totals, was, 'keeperSwings', 5000) && grewBy(d.totals, was, 'readsLanded', 5000)
        && grewBy(d.totals, was, 'predictions', 10000) && grewBy(d.totals, was, 'predictionsCorrect', 10000)
        && d.totals.get('wins', 0) <= d.totals.get('fights', 0);
    }

    // A keeper's record grows by at most one fight (and one win) per write.
    function keeperGrew(d, old, k) {
      let now = d.keepers.get(k, {});
      let was = old.get('keepers', {}).get(k, {});
      let df = now.get('fights', 0) - was.get('fights', 0);
      let dw = now.get('wins', 0) - was.get('wins', 0);
      return df >= 0 && df <= 1 && dw >= 0 && dw <= 1;
    }

    function keepersGrowthOk(d, old) {
      return keeperGrew(d, old, 'warden') && keeperGrew(d, old, 'sage') && keeperGrew(d, old, 'returned');
    }

    function keepersShape(k) {
      return k is map && k.keys().hasOnly(['warden', 'sage', 'returned']);
    }

    function answersShape(a) {
      return a is map && a.keys().hasOnly(['fast', 'heavy', 'feint', 'killer']);
    }

    // The Likert part of the survey (public, anonymous). `at` is the server time of the answer.
    function likert(v) {
      return v is int && v >= 1 && v <= 5;
    }

    function survey(s) {
      return s is map
        && s.keys().hasOnly(['feltRead', 'fair', 'difficulty', 'fun', 'playAgain', 'noticedAdapting', 'at'])
        && s.keys().hasAll(['feltRead', 'fair', 'difficulty', 'fun', 'playAgain', 'noticedAdapting', 'at'])
        && likert(s.feltRead) && likert(s.fair) && likert(s.difficulty) && likert(s.fun) && likert(s.playAgain)
        && s.noticedAdapting is bool && s.at == request.time;
    }

    function playerKeys(d) {
      return d.keys().hasOnly(['v', 'nickname', 'createdAt', 'lastSeen', 'gameVersion', 'difficulty', 'totals',
                               'keepers', 'answers', 'expected', 'survey', 'resets', 'resetAt']);
    }

    // Created once by the game: nickname, server-time createdAt, everything at zero.
    function playerCreateOk(d) {
      return playerKeys(d) && d.keys().hasAll(['v', 'nickname', 'createdAt'])
        && d.v == 1 && nickname(d.nickname) && d.createdAt == request.time
        && (!('lastSeen' in d) || d.lastSeen == request.time)
        && (!('gameVersion' in d) || text(d.gameVersion, 0, 32))
        && (!('difficulty' in d) || difficulty(d.difficulty))
        && (!('totals' in d) || (totalsShape(d.totals) && d.totals.values().hasOnly([0, 0.0])))
        && (!('keepers' in d) || keepersShape(d.keepers))
        && (!('answers' in d) || (answersShape(d.answers) && d.answers.size() == 0))
        && (!('expected' in d) || (d.expected is list && d.expected.size() == 0))
        && !('survey' in d)
        && (!('resets' in d) || d.resets == 0)
        && (!('resetAt' in d) || d.resetAt == null);
    }

    // Updated by the game after every fight (fights / wins / losses / timeouts and each keeper's record grow by at most
    // one), by the site (nickname, survey) and by the reset (totals, keepers and answers to zero, expected [], resets + 1,
    // resetAt now). Only the fields that changed are checked; createdAt never changes.
    function playerUpdateOk(d, old) {
      let changed = d.diff(old).affectedKeys();
      let isReset = changed.hasAny(['resets']);
      return playerKeys(d) && d.keys().hasAll(['v', 'nickname', 'createdAt'])
        && !changed.hasAny(['createdAt'])
        && (!changed.hasAny(['v']) || d.v == 1)
        && (!changed.hasAny(['nickname']) || nickname(d.nickname))
        && (!changed.hasAny(['lastSeen']) || d.lastSeen == request.time)
        && (!changed.hasAny(['gameVersion']) || text(d.gameVersion, 0, 32))
        && (!changed.hasAny(['difficulty']) || difficulty(d.difficulty))
        && (!changed.hasAny(['totals']) || (totalsShape(d.totals) && (isReset || totalsGrowthOk(d, old))))
        && (!changed.hasAny(['keepers']) || (keepersShape(d.keepers) && (isReset || keepersGrowthOk(d, old))))
        && (!changed.hasAny(['answers']) || answersShape(d.answers))
        && (!changed.hasAny(['expected']) || (d.expected is list && d.expected.size() <= 8))
        && (!changed.hasAny(['survey']) || survey(d.survey))
        && (!isReset || (d.resets == old.get('resets', 0) + 1 && d.resetAt == request.time
                         && d.get('totals', {}).values().hasOnly([0, 0.0]) && d.get('expected', []).size() == 0))
        && (!changed.hasAny(['resetAt']) || (isReset && d.resetAt == request.time));
    }

    match /players/{uid} {
      allow read: if true;
      allow create: if isUser(uid) && playerCreateOk(request.resource.data);
      allow update: if isUser(uid) && playerUpdateOk(request.resource.data, resource.data);
      allow delete: if false;
    }

    // ---- fights/{fightId} ---------------------------------------------------------------------------------------

    // The v2 fields (games 1.4.0+): the parry assist (slow motion only with the ring), the keeper's damage scale, the parry
    // window and how well the keeper knew the player when the fight began.
    function assistOk(f) {
      return f.keys().hasAll(['assist', 'slowmoScale', 'keeperDamageScale', 'parryWindowFrames', 'insight'])
        && f.assist in ['off', 'ring', 'ring+slowmo']
        && f.slowmoScale is number && f.slowmoScale > 0 && f.slowmoScale <= 1
        && (f.assist == 'ring+slowmo' || f.slowmoScale == 1)
        && f.keeperDamageScale is number && f.keeperDamageScale > 0 && f.keeperDamageScale <= 2
        && f.parryWindowFrames is int && f.parryWindowFrames >= 1 && f.parryWindowFrames <= 60
        && f.insight is number && f.insight >= 0 && f.insight <= 1;
    }

    // v1 (games 1.0.0 - 1.3.0, accepted forever: offline-queued bodies) or v2. Shape: only the known keys; the fields that
    // identify a fight must be there and valid. The counters inside are the game's (own data only).
    function fightOk(f) {
      return f.keys().hasOnly(['v', 'player', 'at', 'clientTime', 'session', 'fightInSession', 'gameVersion', 'mode',
                               'playMode', 'brain', 'keeper', 'keeperName', 'difficulty', 'skill', 'adaptive', 'result',
                               'seconds', 'playerHealth', 'keeperHealth', 'dmgDealt', 'dmgTaken', 'playerSwings',
                               'playerHits', 'keeperSwings', 'keeperHits', 'keeperBlocked', 'keeperParried',
                               'keeperWhiffed', 'parryAttempts', 'dodges', 'guardBreaks', 'keeperExposed',
                               'readsLanded', 'predictions', 'predictionsCorrect', 'confident', 'confidentCorrect',
                               'expected', 'answers', 'assist', 'slowmoScale', 'keeperDamageScale', 'parryWindowFrames',
                               'insight'])
        && f.keys().hasAll(['v', 'player', 'at', 'session', 'mode', 'playMode', 'brain', 'keeper', 'difficulty', 'result',
                            'seconds'])
        && (f.v == 1 || (f.v == 2 && assistOk(f)))
        && f.at == request.time
        && f.session is string && f.session.size() == 32
        && f.mode in ['openworld', 'arena']
        && f.playMode in ['pathbreaker', 'hellwalker', '66days', 'arena']
        && f.brain in ['rl', 'script']
        && f.keeper in [0, 1, 2]
        && difficulty(f.difficulty)
        && f.result in ['win', 'loss', 'timeout', 'quit']
        && f.seconds is number && f.seconds >= 0 && f.seconds <= 86400;
    }

    match /fights/{fightId} {
      allow read: if true;
      allow create: if fightId.matches('^[0-9a-f]{32}$') && isUser(request.resource.data.player)
        && fightOk(request.resource.data);
      allow update: if false;
      allow delete: if isUser(resource.data.player);
    }

    // ---- surveys/{uid} (private) --------------------------------------------------------------------------------

    match /surveys/{uid} {
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['v', 'comment', 'at'])
        && request.resource.data.keys().hasAll(['v', 'comment', 'at'])
        && request.resource.data.v == 1
        && text(request.resource.data.comment, 0, 500)
        && request.resource.data.at == request.time;
    }
  }
}
